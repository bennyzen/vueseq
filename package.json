{
    "name": "vueseq",
    "version": "0.3.0",
    "description": "A minimal, deterministic video renderer for Vue 3 + GSAP",
    "type": "module",
    "bin": {
        "vueseq": "./bin/cli.js"
    },
    "main": "./src/index.js",
    "types": "./src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        }
    },
    "files": [
        "bin",
        "src"
    ],
    "scripts": {
        "test": "node --test 'test/*.test.js'"
    },
    "keywords": [
        "vue",
        "gsap",
        "video",
        "animation",
        "render",
        "remotion",
        "pellicule"
    ],
    "author": "bennyzen",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bennyzen/vueseq.git"
    },
    "homepage": "https://github.com/bennyzen/vueseq#readme",
    "bugs": {
        "url": "https://github.com/bennyzen/vueseq/issues"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^5.0.0",
        "gsap": "^3.12.0",
        "html2canvas": "^1.4.1",
        "mediabunny": "^1.31.0",
        "playwright": "^1.58.0",
        "vite": "^5.0.0"
    },
    "devDependencies": {
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "semantic-release": "^25.0.2",
        "vue": "^3.4.0"
    },
    "peerDependencies": {
        "vue": "^3.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
